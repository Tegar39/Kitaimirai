label chapter_1_pil1_1:
    $ yuuka_rel += 5
    $ vina_rel += 5
    $ jajan = True

    mc "{cps=40}Alright, I'll go to the cafeteria.{/cps}"
    mc "{cps=40}But you're really paying, Yuuka! Don't take back your word!{/cps}"
    show yuuka s06 with dissolve
    y "{cps=60}Eww, how could you have the heart to make a delicate girl like me take out her wallet?{/cps}"
    
    mc "{cps=40}Delicate? From where... {w=0.1} You were the one who offered in the first place. I'm just collecting on your promise!{/cps}"
    show vina s10 with dissolve
    v "{cps=60}Alright, alright, you two are like cats and dogs when you're together. Let's go, or we'll miss out on a table.{/cps}"
