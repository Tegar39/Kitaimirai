    play music "audio/bgm/schoolgate.mp3" fadein 1.0 volume 0.5
    "{cps=35}The three of us walked down the corridor toward the cafeteria.{/cps}"
    "{cps=35}Along the way, I tried to observe once more.{/cps}"
    "{cps=35}The result was the same: zero.{/cps}"
    "{cps=35}Not a single male student crossed my path.{/cps}"
    show bg event 0_27 with dissolve
    "{cps=35}Every corner of this school was truly dominated by girls.{/cps}"
    "{cps=35}It felt so strange.{/cps}"
    "{cps=35}For the first time in my life, I was in such an extreme environment.{/cps}"
